func _ready() -> void:
	_keys = EN.keys()
	_keys.sort_custom(func(a: String, b: String) -> bool: return a.length() > b.length())

func set_language(value: String) -> void:
	var selected := value if value in ["ru", "en", "uk"] else "ru"
	if language != selected:
		language = selected
		_cache.clear()
		changed.emit()

# Translate templates before substituting their values. Ukrainian coin rewards
# also inflect the noun; older preformatted labels are supported by text().
func format_text(source: String, values: Array) -> String:
	if language == "uk" and source == "ЗАБРАТЬ +%d МОНЕТ" and values.size() == 1:
		return "ЗАБРАТИ +%d %s" % [int(values[0]), _uk_coin_word(int(values[0]))]
	return text(source) % values

func text(source: String) -> String:
	if language == "ru" or source.is_empty():
		return source
	var translations: Dictionary = UK if language == "uk" else EN
	if translations.has(source):
		return translations[source]
	if source.ends_with(" м") and source.left(1).is_valid_int():
		return source if language == "uk" else source.trim_suffix(" м") + " m"
	if source.is_valid_int():
		return source
	if _cache.has(source):
		return _cache[source]
	if _keys.is_empty():
		_ready()
	var result := source
	var rx := RegEx.new()
	rx.compile("Откроется на ([0-9]+) уровне")
	result = rx.sub(result, "Відкриється на $1-му рівні" if language == "uk" else "Unlocks at level $1", true)
	rx.compile("ЗАБРАТЬ \\+([0-9]+) МОНЕТ")
	if language == "uk":
		for match_value: RegExMatch in rx.search_all(result):
			var amount := int(match_value.get_string(1))
			result = result.replace(match_value.get_string(), "ЗАБРАТИ +%d %s" % [amount, _uk_coin_word(amount)])
	else:
		result = rx.sub(result, "CLAIM +$1 COINS", true)
	for key: String in _keys:
		result = result.replace(key, translations[key])
		result = result.replace(key.to_upper(), str(translations[key]).to_upper())
	if language == "en":
		rx.compile("([0-9])\\s?м(?![А-Яа-я])")
		result = rx.sub(result, "$1 m", true)
	if _cache.size() > 512:
		_cache.clear()
	_cache[source] = result
	return result

func _uk_coin_word(amount: int) -> String:
	var last_two := absi(amount) % 100
	var last_one := absi(amount) % 10
	if last_two >= 11 and last_two <= 14:
		return "МОНЕТ"
	if last_one == 1:
		return "МОНЕТУ"
	if last_one >= 2 and last_one <= 4:
		return "МОНЕТИ"
	return "МОНЕТ"
